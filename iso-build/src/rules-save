*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A OUTPUT -m owner --uid-owner tor -j RETURN
-A OUTPUT -d 127.0.0.0/8 -j RETURN
-A OUTPUT -o wg+ -j RETURN
-A OUTPUT -m devgroup --dst-group 51820 -j RETURN
-A OUTPUT -p udp --dport 67:68 -j RETURN
-A OUTPUT -p udp --dport 123 -j RETURN
-A OUTPUT -p tcp --syn -j REDIRECT --to-ports 9040
COMMIT
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p udp --sport 67 --dport 68 -j ACCEPT
-A INPUT -p udp --sport 123 -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
-A OUTPUT -d 127.0.0.0/8 -j ACCEPT
-A OUTPUT -o wg+ -j ACCEPT
-A OUTPUT -m devgroup --dst-group 51820 -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m owner --uid-owner tor -j ACCEPT
-A OUTPUT -p udp --dport 67:68 -j ACCEPT
-A OUTPUT -p udp --dport 123 -j ACCEPT
-A OUTPUT -p udp -m mark ! --mark 0 -j ACCEPT
-A OUTPUT -p udp -m owner --uid-owner 0 -j ACCEPT
-A OUTPUT -j REJECT --reject-with icmp-admin-prohibited
COMMIT
